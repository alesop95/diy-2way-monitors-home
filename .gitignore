# Materiale scritto a mano e segnalibri alla radice del progetto.
# I pattern sono ancorati alla radice con lo slash iniziale: prima erano globali e
# nascondevano per errore file di template e di strumenti che devono essere versionati,
# per esempio tools/dashes-exclude.txt e .claude/templates/latex/tex-packages.txt.
/*.txt
/*.docx
/*.doc
/*.pdf
/*.ppt
/*.pptx
/*.xls
/*.xlsx
/*.gsheet
/*.csv
/*.xml
/*.url
/*.lnk
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.bmp

# Materiali pesanti del progetto: installer Windows, pacchetto degli esempi e licenza.
# Vivono qui solo in transito verso la macchina Ubuntu Studio; l'elenco di che cosa
# contengono e dove vanno sta in docs/TRANSFER-MANIFEST.md.
/Akabak + VACS/

# Eseguibili, archivi e media: mai versionati, in nessuna cartella.
*.exe
*.msi
*.apk
*.zip
*.7z
*.rar
*.mp3
*.wav
*.flac
*.mp4
*.mkv

# Livello privato e verboso: appunti, stati di lavorazione, materiale transitorio
_notes/

# Eccezione: sotto .claude/templates/ i _notes non sono appunti reali ma i modelli
# da cui si istanziano, quindi vanno versionati. Senza questa negazione un clone
# perderebbe i modelli DIARIO, RESOCONTO, RESUME-PROMPT e TEST-CHECKLIST.
# Propagata al template il 2026-09-17 (MS-130): non e' piu' una divergenza. Vale come
# prevenzione di un caso futuro, perche' i modelli erano gia' tracciati.
!.claude/templates/_notes/
!.claude/templates/community-sources/_notes/

# File personali e locali, non condivisi nel repository.
# Ancorati alla radice, cosi' il modello .claude/templates/CLAUDE.local.md resta tracciato.
/CLAUDE.local.md
/.claude/settings.local.json

# Segreti e materiale di credenziale, dallo snippet del template (sezione 6), aggiunti
# il 2026-09-30 al Passo 2 del runbook. Qui non esiste alcun .env: e' difesa in
# profondita', accanto all'hook protect-sensitive-files.
.env
.env.*
!.env.example
*.pem
*.key

# Estratti temporanei di documenti voluminosi (cartelle scratch di doc-ingest).
.tmp-doc-*/

# Dallo snippet NON si prende *.docx globale: i pattern per tipo di file restano
# ancorati alla radice, come dice la testa di questo file (/*.docx piu' sopra).

# Derivati rigenerabili del pacchetto roadmap (pagina HTML e Markdown della roadmap):
# si rigenerano con tools/roadmap.py --write e non si versionano. Aggiunto il 2026-09-30.
/build/

# Ambiente di sviluppo
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Artefatti di sistema operativo e di sincronizzazione
.DS_Store
Thumbs.db
desktop.ini

# File di test della sessione (eliminare a mano)
.claude2/
__guardtest.md

# LaTeX: il .tex e' la fonte, gli ausiliari sono derivati e non si versionano in
# nessuna cartella, quindi questi pattern sono globali come quelli degli archivi.
# Abilitato il 2026-09-21 con l'istanziazione del pacchetto latex.
*.aux
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb

# Il PDF generato NON entra qui come pattern globale, e la ragione e' la stessa
# scritta in testa a questo file: un PDF puo' essere un riferimento legittimamente
# versionato, quindi il suo pattern resta ancorato, cioe' /*.pdf piu' sopra. Quando
# il documento LaTeX avra' una collocazione, si aggiunge il suo percorso preciso.

# Il pacchetto latex istanzia tex-packages.txt alla radice, dove /*.txt lo
# nasconderebbe: la negazione lo riporta nell'indice. E' lo stesso caso che il
# commento in testa a questo file cita per la copia modello dello stesso file.
!/tex-packages.txt
